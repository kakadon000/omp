{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OMP",
  "version": "0.6.0",
  "identifier": "app.omp.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splashscreen",
        "url": "splash.html",
        "width": 380,
        "height": 270,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": true,
        "center": true,
        "focus": false,
        "skipTaskbar": true,
        "shadow": false
      },
      {
        "label": "main",
        "url": "index.html",
        "title": "OMP — Open Media Player",
        "width": 1220,
        "height": 780,
        "minWidth": 860,
        "minHeight": 560,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": [
      "resources/mpv-2.dll",
      "resources/media/*.mp4"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["English"],
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
