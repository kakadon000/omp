{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OMP",
  "version": "0.11.0",
  "identifier": "app.omp.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splashscreen",
        "url": "splash.html",
        "width": 380,
        "height": 270,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": true,
        "center": true,
        "focus": false,
        "skipTaskbar": true,
        "shadow": false
      },
      {
        "label": "main",
        "url": "index.html",
        "title": "OMP — Open Media Player",
        "width": 1220,
        "height": 780,
        "minWidth": 860,
        "minHeight": 560,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": [
      "resources/mpv-2.dll",
      "resources/ffmpeg.exe",
      "resources/yt-dlp.exe",
      "resources/media/*.mp4"
    ],
    "fileAssociations": [
      {
        "name": "OMP Video",
        "description": "Open with OMP — Open Media Player",
        "role": "Viewer",
        "ext": ["mp4", "mkv", "webm", "mov", "avi", "m4v", "wmv", "flv", "ts", "mpg", "mpeg", "ogv", "3gp"]
      },
      {
        "name": "OMP Audio",
        "description": "Open with OMP — Open Media Player",
        "role": "Viewer",
        "ext": ["mp3", "flac", "m4a", "wav", "ogg", "oga", "opus", "aac", "wma"]
      },
      {
        "name": "OMP Image",
        "description": "Open with OMP — Open Media Player",
        "role": "Viewer",
        "ext": ["jpg", "jpeg", "png", "webp", "bmp", "gif", "avif", "tif", "tiff"]
      },
      {
        "name": "OMP Project",
        "description": "OMP editor project — open with the OMP Editor",
        "role": "Editor",
        "ext": ["ompj"]
      },
      {
        "name": "OMP Playlist",
        "description": "IPTV playlist — open with the OMP Live TV importer",
        "role": "Viewer",
        "ext": ["m3u", "m3u8"]
      },
      {
        "name": "OMP Theme",
        "description": "OMP theme — double-click to apply to the Theme Studio",
        "role": "Viewer",
        "ext": ["omptheme"]
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["English"],
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
